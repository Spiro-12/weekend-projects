{
  // Sim purity: the sim core, KPIs, economics and contracts compile with NO DOM and NO node types.
  // Importing three, the DOM, or node built-ins from these folders fails typecheck (PROTOCOL §8).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/sim", "src/kpi", "src/econ", "src/contracts"]
}
