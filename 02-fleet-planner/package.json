  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "mediabunny": "^1.65.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
